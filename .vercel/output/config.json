{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/archive/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/archive/?$",
			"dest": "_render"
		},
		{
			"src": "^/compare/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/?$",
			"dest": "_render"
		},
		{
			"src": "^/fitting/?$",
			"dest": "_render"
		},
		{
			"src": "^/journal/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/journal/?$",
			"dest": "_render"
		},
		{
			"src": "^/marketplace/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/marketplace/?$",
			"dest": "_render"
		},
		{
			"src": "^/rolodex/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}