---
const { settings } = Astro.props || {};
const siteTitle = settings?.siteTitle || 'AJGR.cc';
const footerCredit = settings?.footerCredit || '© 2026 AJGR.cc';
const themeColor = settings?.themeColor || '#C84B8E';
const menuItems = settings?.headerMenu || [
  { label: 'HOME', link: '/' },
  { label: 'JOURNAL', link: '/journal' },
  { label: 'ARCHIVE', link: '/archive' },
  { label: 'ROLODEX', link: '/rolodex' },
  { label: 'EVENTS', link: '/events' },
  { label: 'COMPARE', link: '/compare' },
  { label: 'MARKETPLACE', link: '/marketplace' }
];

import { urlFor } from '../lib/sanity';
const logoUrl = settings?.logo ? urlFor(settings.logo).width(120).url() : null;
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification=61RkIurk9f2WZDVKi9uCisEkc1ANDy9jZKfqSB3F3DA" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2QCG2GN1LH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2QCG2GN1LH');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <!-- Font Premium: Space Grotesk (Heading) & Inter (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <style>
      :root {
        --bg: #FAFAFA;
        --text: #111111;
        --text-muted: #666666;
        --border: #E5E5E5;
        --accent: {themeColor};
        --font-heading: 'Space Grotesk', sans-serif;
        --font-body: 'Inter', sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body { 
        background: var(--bg); 
        color: var(--text); 
        font-family: var(--font-body); 
        font-weight: 400;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      /* Mencegah scroll saat menu mobile terbuka */
      body.menu-open { overflow: hidden; }

      /* HEADER: Ultra clean, border bottom */
      header {
        position: sticky; top: 0; z-index: 100;
        background: rgba(250, 250, 250, 0.95);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }
      header .container {
        max-width: 1440px; margin: 0 auto; padding: 1.25rem 2rem;
        display: flex; justify-content: space-between; align-items: center;
      }
      header .logo-img { height: 32px; width: auto; filter: grayscale(100%); transition: filter 0.3s; }
      header .logo-img:hover { filter: grayscale(0%); }
      header .logo-text { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.03em; text-decoration: none; color: var(--text); }
      header .logo-text span { color: var(--accent); }

      /* Desktop Navigation */
      header nav.desktop-nav ul { display: flex; list-style: none; gap: 2rem; }
      header nav.desktop-nav a { 
        font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--text-muted); text-decoration: none; transition: color 0.2s;
      }
      header nav.desktop-nav a:hover { color: var(--text); }

      /* Hamburger Button (Hidden on Desktop) */
      .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        z-index: 102;
      }
      .hamburger span {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--text);
        transition: all 0.3s ease;
        border-radius: 2px;
      }
      /* Animasi Hamburger menjadi X */
      .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
      .hamburger.active span:nth-child(2) { opacity: 0; }
      .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

      /* Mobile Menu Overlay */
      .mobile-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background: var(--bg);
        z-index: 101;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        transform: translateY(-100%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .mobile-menu.active {
        transform: translateY(0);
      }
      
      /* Tombol Close (X) di Mobile Menu */
      .mobile-menu-close {
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        width: 44px;
        height: 44px;
        background: none;
        border: 2px solid var(--border);
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        z-index: 103;
      }
      .mobile-menu-close:hover {
        border-color: var(--accent);
        background: var(--accent);
        transform: rotate(90deg);
      }
      .mobile-menu-close:hover svg {
        stroke: white;
      }
      .mobile-menu-close svg {
        width: 24px;
        height: 24px;
        stroke: var(--text);
        stroke-width: 2;
        stroke-linecap: round;
        transition: stroke 0.3s ease;
      }
      
      .mobile-menu a {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: color 0.2s;
      }
      .mobile-menu a:hover {
        color: var(--accent);
      }

      main { max-width: 1440px; margin: 0 auto; padding: 0 2rem; }

      /* UTILITIES */
      .label { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text-muted); margin-bottom: 0.75rem; display: block; }
      .label-accent { color: var(--accent); }
      
      /* RESPONSIVE */
      @media (max-width: 768px) {
        header nav.desktop-nav { display: none; }
        .hamburger { display: flex; }
      }

      @media (min-width: 769px) {
        .hamburger { display: none; }
        .mobile-menu { display: none; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="logo">
          {logoUrl ? <img src={logoUrl} alt="Logo" class="logo-img" /> : <span class="logo-text">AJGR<span>.cc</span></span>}
        </a>
        
        <!-- Desktop Menu -->
        <nav class="desktop-nav">
          <ul>
            {menuItems.map((item: any) => <li><a href={item.link}>{item.label}</a></li>)}
          </ul>
        </nav>

        <!-- Hamburger Button (Mobile Only) -->
        <button class="hamburger" id="hamburger-btn" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    
    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu" id="mobile-menu">
      <!-- Tombol Close (X) -->
      <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Tutup menu">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      {menuItems.map((item: any) => (
        <a href={item.link} class="mobile-link">{item.label}</a>
      ))}
    </div>
    
    <main><slot /></main>
    
        <!-- FOOTER DENGAN "Follow Us on:" DAN SOSIAL MEDIA -->
    <footer style="border-top: 1px solid var(--border, #E5E5E5); padding: 3rem 4rem; background: #FAFAFA;">
      <div class="footer-container" style="max-width: 1440px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
        
        <!-- Left: Copyright -->
        <div class="footer-left" style="flex: 1; min-width: 200px;">
          <p style="font-size: 0.75rem; color: var(--text-muted, #666); letter-spacing: 0.1em; text-transform: uppercase; margin: 0; text-align: left;">
            {footerCredit}
          </p>
        </div>

        <!-- Right: Social Media -->
        <div class="footer-right" style="flex: 1; min-width: 200px; display: flex; justify-content: flex-end; align-items: center; gap: 1rem;">
          <p style="font-size: 0.75rem; color: var(--text-muted, #666); letter-spacing: 0.1em; text-transform: uppercase; margin: 0;">
            Follow Us on:
          </p>
          
          <!-- Wrapper Ikon Sosial Media (selalu horizontal) -->
          <div class="social-icons" style="display: flex; gap: 0.75rem; align-items: center;">
            <!-- Instagram -->
            <a href="https://www.instagram.com/ajgr.cc/" target="_blank" rel="noopener noreferrer" aria-label="Instagram AJGR.cc"
               style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border, #E5E5E5); border-radius: 50%; text-decoration: none; color: var(--text, #111); transition: all 0.3s ease;"
               onmouseover="this.style.borderColor='var(--accent, #C84B8E)'; this.style.backgroundColor='var(--accent, #C84B8E)'; this.style.color='white'"
               onmouseout="this.style.borderColor='var(--border, #E5E5E5)'; this.style.backgroundColor='transparent'; this.style.color='var(--text, #111)'">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            
            <!-- TikTok -->
            <a href="https://www.tiktok.com/@ajgr.cc" target="_blank" rel="noopener noreferrer" aria-label="TikTok AJGR.cc"
               style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--border, #E5E5E5); border-radius: 50%; text-decoration: none; color: var(--text, #111); transition: all 0.3s ease;"
               onmouseover="this.style.borderColor='var(--accent, #C84B8E)'; this.style.backgroundColor='var(--accent, #C84B8E)'; this.style.color='white'"
               onmouseout="this.style.borderColor='var(--border, #E5E5E5)'; this.style.backgroundColor='transparent'; this.style.color='var(--text, #111)'">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Responsive Styles untuk Footer -->
      <style>
        @media (max-width: 768px) {
          footer {
            padding: 2.5rem 1.5rem !important;
          }
          .footer-container {
            flex-direction: column !important;
            text-align: center !important;
            gap: 1.5rem !important;
          }
          .footer-left,
          .footer-right {
            width: 100% !important;
            justify-content: center !important;
            text-align: center !important;
          }
          .footer-left p {
            text-align: center !important;
          }
          .footer-right {
            flex-direction: column !important; /* Teks "Follow Us on:" di atas ikon */
            gap: 1rem !important;
          }
          /* Ikon sosial media TETAP HORIZONTAL (berdampingan) */
          .social-icons {
            flex-direction: row !important;
            justify-content: center !important;
          }
        }
      </style>
    </footer>

    <!-- Script untuk mengontrol Hamburger Menu -->
    <script is:inline>
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuClose = document.getElementById('mobile-menu-close');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function openMenu() {
        hamburgerBtn.classList.add('active');
        mobileMenu.classList.add('active');
        document.body.classList.add('menu-open');
      }

      function closeMenu() {
        hamburgerBtn.classList.remove('active');
        mobileMenu.classList.remove('active');
        document.body.classList.remove('menu-open');
      }

      function toggleMenu() {
        if (mobileMenu.classList.contains('active')) {
          closeMenu();
        } else {
          openMenu();
        }
      }

      if (hamburgerBtn) {
        hamburgerBtn.addEventListener('click', toggleMenu);
      }

      if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', closeMenu);
      }

      // Tutup menu otomatis saat salah satu link diklik
      mobileLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      // Tutup menu saat klik area di luar (overlay)
      if (mobileMenu) {
        mobileMenu.addEventListener('click', (e) => {
          if (e.target === mobileMenu) {
            closeMenu();
          }
        });
      }

      // Tutup menu saat tekan tombol ESC
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu.classList.contains('active')) {
          closeMenu();
        }
      });
    </script>
  </body>
</html>