---
export const prerender = false;

import Layout from '../layouts/Layout.astro'
import client from '../lib/sanity'
import { urlFor, getSiteSettings } from '../lib/sanity'

const settings = await getSiteSettings()
const eventsSettings = settings?.eventsSection || {}
const eventsLabel = eventsSettings.label || '05 — CALENDAR'
const eventsTitle = eventsSettings.title || 'Upcoming Events'
const eventsDescription = eventsSettings.description || 'Agenda kegiatan, gowes bersama, dan event komunitas AJGR.cc.'

// Ambil semua event, urutkan dari tanggal terdekat
const events = await client.fetch(`*[_type == "event"] | order(startDate asc){
  title, slug, startDate, endDate, category, location, description, poster, status, price, quota, registeredCount, registrationLink, contactPIC, meetingPoint, finishPoint, isFeatured
}`)

// Helper functions
function formatDate(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
}

function formatTime(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleTimeString('id-ID', { 
    hour: '2-digit', 
    minute: '2-digit',
    timeZone: 'Asia/Makassar'  // ← TAMBAHKAN INI
  })
}

function getStatusBadge(status) {
  const statusMap = {
    'coming-soon': { label: 'COMING SOON', color: '#E8C547', bg: 'rgba(232, 197, 71, 0.1)' },
    'open': { label: 'OPEN REGISTRATION', color: '#22C55E', bg: 'rgba(34, 197, 94, 0.1)' },
    'full': { label: 'FULL', color: '#EF4444', bg: 'rgba(239, 68, 68, 0.1)' },
    'finished': { label: 'SELESAI', color: '#6B7280', bg: 'rgba(107, 114, 128, 0.1)' },
    'cancelled': { label: 'DIBATALKAN', color: '#6B7280', bg: 'rgba(107, 114, 128, 0.1)' },
  }
  return statusMap[status] || statusMap['coming-soon']
}

// Generate Google Calendar URL
function getGoogleCalendarUrl(event) {
  const startDate = new Date(event.startDate)
  const endDate = event.endDate ? new Date(event.endDate) : new Date(startDate.getTime() + 2 * 60 * 60 * 1000)
  
  const formatDateForGCal = (date) => {
    return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '')
  }
  
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: event.title,
    dates: formatDateForGCal(startDate) + '/' + formatDateForGCal(endDate),
    details: event.description || '',
    location: event.meetingPoint || event.finishPoint || event.location || '',
  })
  
  return 'https://calendar.google.com/calendar/render?' + params.toString()
}
---

<Layout settings={settings}>
  <style>
    html, body { overflow-x: hidden !important; max-width: 100vw !important; }
    * { box-sizing: border-box; }

    .event-poster {
      width: 100%; height: auto; display: block;
      background: #F0F0F0; overflow: hidden; margin-bottom: 0;
    }
    .event-poster img { width: 100%; height: auto; display: block; }

    .event-card {
      border-right: 1px solid var(--border, #E5E5E5);
      border-bottom: 1px solid var(--border, #E5E5E5);
      padding: 3rem;
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 3rem;
      align-items: start;
      transition: background-color 0.3s ease;
    }

    .event-info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .event-info-item { padding: 1rem 0; }

    /* ===== PERBAIKAN TOMBOL HADIR ===== */
    .attend-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #FFFFFF !important; /* Teks putih eksplisit */
      background-color: #C84B8E !important; /* Background pink eksplisit */
      border: 2px solid #C84B8E !important;
      border-radius: 4px;
      padding: 1rem 1.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: 'Space Grotesk', sans-serif;
      text-decoration: none;
    }
    
    .attend-btn:hover:not(:disabled) {
      background-color: #A03D72 !important; /* Pink lebih gelap saat hover */
      border-color: #A03D72 !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(200, 75, 142, 0.3);
    }
    
    .attend-btn:disabled {
      background-color: #22C55E !important; /* Hijau saat sudah terdaftar */
      border-color: #22C55E !important;
      color: #FFFFFF !important;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }
    
    .attend-btn.loading {
      opacity: 0.7;
      cursor: wait;
    }

    @media (max-width: 768px) {
      .event-card {
        grid-template-columns: 1fr !important;
        gap: 2rem !important;
        padding: 1.5rem !important;
      }
      .event-info-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
      .event-info-item { padding: 1.25rem 0; border-bottom: 1px solid var(--border, #E5E5E5); }
      .event-info-item:last-child { border-bottom: none; padding-bottom: 0; }
      h2 { font-size: 1.5rem !important; word-break: break-word; }
      p { font-size: 0.95rem !important; }
    }
  </style>

  <!-- HEADER SECTION -->
  <section style="padding: 6rem 0 4rem; border-bottom: 1px solid var(--border, #E5E5E5);">
    <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 1rem; display: block;">
      {eventsLabel}
    </span>
    <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 600; letter-spacing: -0.03em; margin-top: 1rem; color: var(--text, #111111);">
      {eventsTitle}
    </h1>
    <p style="margin-top: 1.5rem; font-size: 1.125rem; color: var(--text-muted, #666666); max-width: 600px; line-height: 1.6;">
      {eventsDescription}
    </p>
  </section>

  <!-- EVENTS GRID -->
  <section style="padding: 4rem 0 6rem;">
    {events.length > 0 ? (
      <div style="display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--border, #E5E5E5); border-left: 1px solid var(--border, #E5E5E5);">
        {events.map((event) => {
          const badge = getStatusBadge(event.status)
          const currentCount = event.registeredCount || 0
          const quota = event.quota || 0
          const calendarUrl = getGoogleCalendarUrl(event)
          
          return (
            <article class="event-card" onmouseover="this.style.backgroundColor='#F8F8F8'" onmouseout="this.style.backgroundColor='transparent'">
              
              <!-- Left Column: Poster Dinamis -->
              <div>
                <div class="event-poster">
                  {event.poster ? (
                    <img src={urlFor(event.poster).width(800).url()} alt={event.title} />
                  ) : (
                    <div style="aspect-ratio: 1/1; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%); display: flex; align-items: center; justify-content: center;">
                      <span style="font-size: 3rem; color: white;">📅</span>
                    </div>
                  )}
                </div>
              </div>

              <!-- Right Column: Content -->
              <div>
                <!-- Category -->
                <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 0.5rem;">
                  {event.category || 'EVENT'}
                </p>

                <!-- Title -->
                <a href={`/events/${event.slug.current}`} style="text-decoration: none; color: inherit; display: block; margin-bottom: 1rem;">
                  <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111111); line-height: 1.2; transition: color 0.2s;"
                      onmouseover="this.style.color='var(--accent, #C84B8E)'"
                      onmouseout="this.style.color='var(--text, #111111)'">
                    {event.title}
                  </h2>
                </a>

                <!-- Description -->
                {event.description && (
                  <p style="font-size: 1rem; color: var(--text-muted, #666666); line-height: 1.7; margin-bottom: 1.5rem;">
                    {event.description}
                  </p>
                )}

                <!-- Status Badge -->
                <div style="margin-bottom: 2rem;">
                  <span style="display: inline-block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: {badge.color}; background: {badge.bg}; padding: 0.5rem 1rem;">
                    {badge.label}
                  </span>
                </div>

                <!-- Info Grid -->
                <div class="event-info-grid" style="margin-bottom: 2rem; padding: 2rem; background: #FAFAFA; border: 1px solid var(--border, #E5E5E5);">
                  
                  <!-- Tanggal & Waktu -->
                  <div class="event-info-item">
                    <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 0.75rem; font-weight: 600;">📅 Tanggal & Waktu</p>
                    <p style="font-size: 1rem; color: #111; font-weight: 600; margin-bottom: 0.25rem; line-height: 1.4;">
                      {formatDate(event.startDate)}
                    </p>
                    <p style="font-size: 0.95rem; color: #666; font-weight: 400;">
                      {formatTime(event.startDate)} WITA
                    </p>
                  </div>

                  <!-- Titik Kumpul -->
                  {event.meetingPoint && (
                    <div class="event-info-item">
                      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 0.75rem; font-weight: 600;">📍 Titik Kumpul</p>
                      <p style="font-size: 1rem; color: #111; font-weight: 500; word-break: break-word; line-height: 1.5;">{event.meetingPoint}</p>
                    </div>
                  )}

                  <!-- Titik Finish -->
                  {event.finishPoint && (
                    <div class="event-info-item">
                      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 0.75rem; font-weight: 600;">🏁 Titik Finish</p>
                      <p style="font-size: 1rem; color: #111; font-weight: 500; word-break: break-word; line-height: 1.5;">{event.finishPoint}</p>
                    </div>
                  )}

                  <!-- Kuota Peserta (DENGAN ID UNTUK FIREBASE) -->
                  {event.quota && (
                    <div class="event-info-item">
                      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 0.75rem; font-weight: 600;">👥 Kuota Peserta</p>
                      <p class="quota-display" data-slug={event.slug.current} data-initial={currentCount} style="font-size: 1rem; color: #111; font-weight: 600;">
                        {currentCount} / {quota} peserta
                      </p>
                    </div>
                  )}

                  <!-- Kontak PIC -->
                  {event.contactPIC && (
                    <div class="event-info-item">
                      <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 0.75rem; font-weight: 600;">📞 Kontak PIC</p>
                      <p style="font-size: 0.95rem; color: #111; font-weight: 500; word-break: break-word;">{event.contactPIC}</p>
                    </div>
                  )}
                </div>

                <!-- Action Buttons -->
                <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
                  {event.registrationLink && event.status !== 'finished' && event.status !== 'cancelled' && (
                    <a 
                      href={event.registrationLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: white; background: var(--text, #111111); text-decoration: none; padding: 1rem 1.5rem; transition: all 0.2s ease;"
                      onmouseover="this.style.backgroundColor='var(--accent, #C84B8E)'"
                      onmouseout="this.style.backgroundColor='var(--text, #111111)'"
                    >
                      📝 Daftar Sekarang
                    </a>
                  )}
                  
                  <!-- ADD TO CALENDAR -->
                  {event.status !== 'finished' && event.status !== 'cancelled' && (
                    <a 
                      href={calendarUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: white; background: #4285F4; text-decoration: none; padding: 1rem 1.5rem; transition: all 0.2s ease;"
                      onmouseover="this.style.backgroundColor='#3367D6'"
                      onmouseout="this.style.backgroundColor='#4285F4'"
                    >
                      📅 Add to Calendar
                    </a>
                  )}

                  <!-- TOMBOL SAYA AKAN HADIR (FIREBASE) -->
                  {event.status === 'open' && event.quota && (
                    <button 
                      class="attend-btn"
                      data-slug={event.slug.current}
                      data-quota={quota}
                    >
                      🙋 Saya akan hadir
                    </button>
                  )}

                  {event.mapsLink && (
                    <a 
                      href={event.mapsLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111111); text-decoration: none; border: 1px solid var(--text, #111111); padding: 1rem 1.5rem; transition: all 0.2s ease;"
                      onmouseover="this.style.backgroundColor='var(--text, #111111)'; this.style.color='#FAFAFA'"
                      onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--text, #111111)'"
                    >
                      🗺️ Lihat Peta Rute
                    </a>
                  )}
                </div>
              </div>
            </article>
          )
        })}
      </div>
    ) : (
      <div style="text-align: center; padding: 6rem 2rem; border: 1px solid var(--border, #E5E5E5);">
        <p style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 600; color: var(--text, #111111); margin-bottom: 0.5rem;">Belum Ada Event</p>
        <p style="color: var(--text-muted, #666666); font-size: 0.9rem;">Jadwal kegiatan akan segera diumumkan. Stay tuned!</p>
      </div>
    )}
  </section>

  <!-- FIREBASE SDK + LOGIKA TOMBOL HADIR (COMPAT VERSION) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      
      // 1. Load Firebase Compat SDKs secara dinamis
      const appScript = document.createElement('script');
      appScript.src = 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js';
      document.head.appendChild(appScript);

      const dbScript = document.createElement('script');
      dbScript.src = 'https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js';
      document.head.appendChild(dbScript);

      dbScript.onload = function() {
        console.log('✅ Firebase SDK Loaded');
        
        // 2. Konfigurasi Firebase
        const firebaseConfig = {
          apiKey: "AIzaSyBnwsQrgK-D_1GTEsl10WtIJdw180o-CtA",
          authDomain: "ajgr-events.firebaseapp.com",
          databaseURL: "https://ajgr-events-default-rtdb.asia-southeast1.firebasedatabase.app",
          projectId: "ajgr-events",
          storageBucket: "ajgr-events.appspot.com",
          messagingSenderId: "358289277112",
          appId: "1:358289277112:web:8a5e4a2961670fd144f44d"
        };

        // Inisialisasi
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();
        console.log('✅ Firebase Initialized');

        // 3. Real-time Listener untuk Kuota
        const quotaDisplays = document.querySelectorAll('.quota-display');
        console.log('Ditemukan ' + quotaDisplays.length + ' elemen kuota');
        
        quotaDisplays.forEach(display => {
          const slug = display.getAttribute('data-slug');
          const initialCount = parseInt(display.getAttribute('data-initial')) || 0;
          
          // Ambil quota dari tombol di card yang sama
          const card = display.closest('.event-card');
          const attendBtn = card ? card.querySelector('.attend-btn') : null;
          const quota = attendBtn ? parseInt(attendBtn.getAttribute('data-quota')) : 25;

          const eventRef = database.ref('events/' + slug + '/attendeeCount');
          
          // Listen real-time
          eventRef.on('value', (snapshot) => {
            const count = snapshot.val() !== null ? snapshot.val() : initialCount;
            display.textContent = count + ' / ' + quota + ' peserta';
            
            if (count >= quota) {
              display.style.color = '#EF4444';
              display.style.fontWeight = '700';
            } else if (count > initialCount) {
              display.style.color = '#22C55E';
            }
          });
        });

        // 4. Logika Tombol "Saya akan hadir"
        const buttons = document.querySelectorAll('.attend-btn');
        console.log('Ditemukan ' + buttons.length + ' tombol hadir');
        
        buttons.forEach(btn => {
          const slug = btn.getAttribute('data-slug');
          const quota = parseInt(btn.getAttribute('data-quota'));
          const storageKey = 'ajgr_attended_' + slug;

          // Cek apakah sudah pernah klik di device ini
          if (localStorage.getItem(storageKey)) {
            markAsAttended(btn);
            return;
          }

          btn.addEventListener('click', async function(e) {
            e.preventDefault();
            if (localStorage.getItem(storageKey)) return;

            // Loading state
            btn.disabled = true;
            btn.classList.add('loading');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '⏳ Memproses...';

            try {
              const countRef = database.ref('events/' + slug + '/attendeeCount');
              
              // Ambil nilai saat ini
              const snapshot = await countRef.once('value');
              const currentCount = snapshot.val() || 0;

              // Cek kuota
              if (currentCount >= quota) {
                alert('Maaf, kuota sudah penuh!');
                btn.disabled = false;
                btn.innerHTML = originalHTML;
                btn.classList.remove('loading');
                return;
              }

              // Increment counter
              await countRef.set(currentCount + 1);
              
              // Simpan ke localStorage
              localStorage.setItem(storageKey, 'true');
              
              // Update UI
              markAsAttended(btn);

            } catch (error) {
              console.error('❌ Error:', error);
              alert('Terjadi kesalahan: ' + error.message);
              btn.disabled = false;
              btn.innerHTML = originalHTML;
              btn.classList.remove('loading');
            }
          });
        });

        // Fungsi helper untuk menandai tombol
        function markAsAttended(btn) {
          btn.innerHTML = '✓ ANDA SUDAH TERDAFTAR';
          btn.disabled = true;
          // Style sudah dihandle oleh CSS .attend-btn:disabled
          btn.classList.remove('loading');
        }
      };

      dbScript.onerror = function() {
        console.error('❌ Gagal memuat Firebase SDK!');
      };
    });
  </script>
</Layout>