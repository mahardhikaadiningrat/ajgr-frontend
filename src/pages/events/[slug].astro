---
export const prerender = false;

import Layout from '../../layouts/Layout.astro'
import client from '../../lib/sanity'
import { urlFor, getSiteSettings } from '../../lib/sanity'

// Ambil slug dari URL
const { slug } = Astro.params

// Ambil data event berdasarkan slug
const event = await client.fetch(`*[_type == "event" && slug.current == $slug][0]{
  title,
  slug,
  startDate,
  endDate,
  category,
  location,
  mapsLink,
  description,
  poster,
  status,
  price,
  quota,
  registeredCount,
  registrationLink,
  contactPIC,
  isFeatured
}`, { slug })

// Jika event tidak ditemukan, redirect ke halaman events
if (!event) {
  return Astro.redirect('/events')
}

// Ambil settings
const settings = await getSiteSettings()

// Helper functions
function formatDate(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleDateString('id-ID', { 
    weekday: 'long',
    day: 'numeric', 
    month: 'long', 
    year: 'numeric' 
  })
}

function formatTime(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleTimeString('id-ID', { 
    hour: '2-digit', 
    minute: '2-digit' 
  })
}

function getStatusBadge(status) {
  const statusMap = {
    'coming-soon': { label: 'COMING SOON', color: '#E8C547', bg: 'rgba(232, 197, 71, 0.1)' },
    'open': { label: 'OPEN REGISTRATION', color: '#22C55E', bg: 'rgba(34, 197, 94, 0.1)' },
    'full': { label: 'FULL', color: '#EF4444', bg: 'rgba(239, 68, 68, 0.1)' },
    'finished': { label: 'SELESAI', color: '#6B7280', bg: 'rgba(107, 114, 128, 0.1)' },
    'cancelled': { label: 'DIBATALKAN', color: '#6B7280', bg: 'rgba(107, 114, 128, 0.1)' },
  }
  return statusMap[status] || statusMap['coming-soon']
}

function generateGoogleCalendarLink(event) {
  const start = new Date(event.startDate).toISOString().replace(/-|:|\.\d+/g, '')
  const end = event.endDate 
    ? new Date(event.endDate).toISOString().replace(/-|:|\.\d+/g, '')
    : new Date(new Date(event.startDate).getTime() + 2 * 60 * 60 * 1000).toISOString().replace(/-|:|\.\d+/g, '')
  
  return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.title)}&dates=${start}/${end}&details=${encodeURIComponent(event.description || '')}&location=${encodeURIComponent(event.location || '')}`
}

const badge = getStatusBadge(event.status)
const calendarLink = generateGoogleCalendarLink(event)
---

<Layout settings={settings}>
  <!-- BREADCRUMB -->
  <nav style="padding: 2rem 0; border-bottom: 1px solid var(--border, #E5E5E5);">
    <a href="/events" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); text-decoration: none;">
      ← Back to Events
    </a>
  </nav>

  <!-- HERO SECTION -->
  <section style="padding: 4rem 0 3rem;">
    <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 1rem; display: block;">
      {event.category || 'EVENT'}
    </span>
    
    <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 600; letter-spacing: -0.03em; margin: 1rem 0 2rem; color: var(--text, #111); line-height: 1.05;">
      {event.title}
    </h1>
    
    <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
      <span style="display: inline-block; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: {badge.color}; background: {badge.bg}; padding: 0.4rem 0.8rem;">
        {badge.label}
      </span>
      <span style="font-size: 0.85rem; color: var(--text-muted, #666);">
        {formatDate(event.startDate)} · {formatTime(event.startDate)} WITA
      </span>
    </div>
  </section>

  <!-- MAIN CONTENT GRID -->
  <section style="padding: 2rem 0 6rem; display: grid; grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: start;">
    
    <!-- Left Column: Poster & Description -->
    <div>
      {event.poster ? (
        <div style="aspect-ratio: 16/9; background: #F0F0F0; overflow: hidden; margin-bottom: 3rem;">
          <img 
            src={urlFor(event.poster).width(1200).url()} 
            alt={event.title}
            style="width: 100%; height: 100%; object-fit: cover;"
          />
        </div>
      ) : (
        <div style="aspect-ratio: 16/9; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%); display: flex; align-items: center; justify-content: center; margin-bottom: 3rem;">
          <span style="font-size: 5rem; color: white;">📅</span>
        </div>
      )}

      {event.description && (
        <div style="border-top: 1px solid var(--border, #E5E5E5); padding-top: 2rem;">
          <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 1rem; color: var(--text, #111);">
            Tentang Event
          </h2>
          <p style="font-size: 1rem; color: var(--text-muted, #666); line-height: 1.8; white-space: pre-wrap;">
            {event.description}
          </p>
        </div>
      )}
    </div>

    <!-- Right Column: Info Sidebar -->
    <aside style="position: sticky; top: 100px;">
      <div style="border: 1px solid var(--border, #E5E5E5); padding: 2rem; margin-bottom: 1.5rem;">
        <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text-muted, #666); margin-bottom: 1.5rem;">
          Detail Event
        </h3>

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border, #E5E5E5);">
            <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">Tanggal & Waktu</p>
            <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 600; color: var(--text, #111); line-height: 1.4;">
              {formatDate(event.startDate)}
            </p>
            <p style="font-size: 0.9rem; color: var(--text-muted, #666);">
              {formatTime(event.startDate)} WITA
            </p>
            {event.endDate && (
              <p style="font-size: 0.85rem; color: var(--text-muted, #666); margin-top: 0.5rem;">
                s/d {formatDate(event.endDate)}
              </p>
            )}
          </div>

          {event.location && (
            <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border, #E5E5E5);">
              <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">Lokasi</p>
              <p style="font-size: 1rem; color: var(--text, #111); font-weight: 500; line-height: 1.5;">
                {event.location}
              </p>
            </div>
          )}

          {event.price && (
            <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border, #E5E5E5);">
              <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">Biaya</p>
              <p style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; color: var(--accent, #C84B8E);">
                {event.price}
              </p>
            </div>
          )}

          {event.quota && (
            <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border, #E5E5E5);">
              <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">Kuota Peserta</p>
              <p style="font-size: 1rem; color: var(--text, #111); font-weight: 500;">
                {event.registeredCount || 0} / {event.quota} peserta
              </p>
              <!-- Progress Bar -->
              <div style="margin-top: 0.75rem; height: 4px; background: #F0F0F0; border-radius: 2px; overflow: hidden;">
                <div style="height: 100%; width: {((event.registeredCount || 0) / event.quota) * 100}%; background: var(--accent, #C84B8E); transition: width 0.3s;"></div>
              </div>
            </div>
          )}

          {event.contactPIC && (
            <div>
              <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #999; margin-bottom: 0.5rem;">Kontak PIC</p>
              <p style="font-size: 0.95rem; color: var(--text, #111); font-weight: 500;">
                {event.contactPIC}
              </p>
            </div>
          )}
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {event.registrationLink && event.status !== 'finished' && event.status !== 'cancelled' && (
          <a 
            href={event.registrationLink}
            target="_blank"
            rel="noopener noreferrer"
            style="display: block; text-align: center; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: white; background: var(--text, #111); text-decoration: none; padding: 1rem; transition: all 0.2s ease;"
            onmouseover="this.style.backgroundColor='var(--accent, #C84B8E)'"
            onmouseout="this.style.backgroundColor='var(--text, #111)'"
          >
            Daftar Sekarang →
          </a>
        )}

        {event.mapsLink && (
          <a 
            href={event.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            style="display: block; text-align: center; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border: 1px solid var(--text, #111); padding: 1rem; transition: all 0.2s ease;"
            onmouseover="this.style.backgroundColor='var(--text, #111)'; this.style.color='#FAFAFA'"
            onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--text, #111)'"
          >
             Buka di Google Maps
          </a>
        )}

        <a 
          href={calendarLink}
          target="_blank"
          rel="noopener noreferrer"
          style="display: block; text-align: center; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); text-decoration: none; border: 1px solid var(--border, #E5E5E5); padding: 1rem; transition: all 0.2s ease;"
          onmouseover="this.style.borderColor='var(--text, #111)'; this.style.color='var(--text, #111)'"
          onmouseout="this.style.borderColor='var(--border, #E5E5E5)'; this.style.color='var(--text-muted, #666)'"
        >
          📅 Tambah ke Google Calendar
        </a>
      </div>
    </aside>
  </section>
</Layout>