---
export const prerender = false;

import Layout from '../../layouts/Layout.astro'
import client from '../../lib/sanity'
import { urlFor, getSiteSettings } from '../../lib/sanity'

const { slug } = Astro.params

// Ambil data event berdasarkan slug
const event = await client.fetch(`*[_type == "event" && slug.current == $slug][0]{
  title, slug, startDate, endDate, category, location, description, poster, status, price, quota, registeredCount, registrationLink, contactPIC, meetingPoint, finishPoint, mapsLink
}`, { slug })

if (!event) {
  return Astro.redirect('/events')
}

const settings = await getSiteSettings()

// Helper functions
function formatDate(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
}

function formatTime(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })
}

function formatDay(dateStr) {
  const date = new Date(dateStr)
  return date.toLocaleDateString('id-ID', { weekday: 'long' })
}

// Helper: Format harga dengan logika dinamis
function formatPrice(price) {
  if (!price && price !== 0) return null  // Kosong/null → tidak tampil
  if (price === 0) return null            // 0 → tidak tampil
  
  // Jika string "Gratis" atau "gratis"
  if (typeof price === 'string' && price.toLowerCase() === 'gratis') {
    return 'Gratis'
  }
  
  // Jika angka
  if (typeof price === 'number') {
    if (price === 0) return null
    return 'Rp ' + price.toLocaleString('id-ID')
  }
  
  // Jika string angka (misal "50000")
  if (typeof price === 'string') {
    const num = parseFloat(price.replace(/[^0-9]/g, ''))
    if (isNaN(num) || num === 0) return null
    return 'Rp ' + num.toLocaleString('id-ID')
  }
  
  return null
}

// Cek apakah biaya harus ditampilkan
const displayPrice = formatPrice(event.price)

// Generate Google Calendar URL
function getGoogleCalendarUrl(event) {
  const startDate = new Date(event.startDate)
  const endDate = event.endDate ? new Date(event.endDate) : new Date(startDate.getTime() + 2 * 60 * 60 * 1000)
  
  const formatDateForGCal = (date) => {
    return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '')
  }
  
  const params = new URLSearchParams({
    action: 'TEMPLATE',
    text: event.title,
    dates: formatDateForGCal(startDate) + '/' + formatDateForGCal(endDate),
    details: event.description || '',
    location: event.meetingPoint || event.finishPoint || event.location || '',
  })
  
  return 'https://calendar.google.com/calendar/render?' + params.toString()
}

const calendarUrl = getGoogleCalendarUrl(event)
const currentCount = event.registeredCount || 0
const quota = event.quota || 0
---

<Layout settings={settings}>
  <style>
    html, body { overflow-x: hidden !important; max-width: 100vw !important; }
    * { box-sizing: border-box; }

    .event-detail-grid {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 3rem;
      padding: 3rem 0;
      max-width: 1400px;
      margin: 0 auto;
    }

    .event-info-sidebar {
      position: sticky;
      top: 100px;
      padding: 2rem;
      background: white;
      border: 1px solid var(--border, #E5E5E5);
      border-radius: 4px;
      height: fit-content;
    }

    .info-item {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border, #E5E5E5);
    }
    .info-item:last-child {
      border-bottom: none;
    }

    .info-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #666;
      margin-bottom: 0.75rem;
      font-weight: 600;
    }

    .info-value {
      font-size: 1rem;
      color: #111;
      font-weight: 500;
      line-height: 1.5;
    }

    .quota-display {
      font-size: 1.25rem;
      font-weight: 700;
      color: #111;
    }

    /* Poster di bawah judul */
    .event-poster-inline {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 2rem 0;
      padding: 1rem;
      background: #F8F8F8;
      border-radius: 8px;
      border: 1px solid var(--border, #E5E5E5);
    }
    
    .event-poster-inline img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 700px;
      display: block;
      object-fit: contain;
    }

    /* Tombol Hadir */
    .attend-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #FFFFFF !important;
      background-color: #C84B8E !important;
      border: 2px solid #C84B8E !important;
      border-radius: 4px;
      padding: 1rem 1.5rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: 'Space Grotesk', sans-serif;
      text-decoration: none;
      width: 100%;
      margin-top: 1rem;
    }
    
    .attend-btn:hover:not(:disabled) {
      background-color: #A03D72 !important;
      border-color: #A03D72 !important;
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(200, 75, 142, 0.3);
    }
    
    .attend-btn:disabled {
      background-color: #22C55E !important;
      border-color: #22C55E !important;
      color: #FFFFFF !important;
      cursor: not-allowed;
      transform: none !important;
    }
    
    .attend-btn.loading {
      opacity: 0.7;
      cursor: wait;
    }

    .calendar-btn {
      display: block;
      width: 100%;
      text-align: center;
      padding: 1rem;
      border: 1px solid var(--border, #E5E5E5);
      background: white;
      text-decoration: none;
      color: var(--text, #111);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      transition: all 0.2s ease;
      margin-top: 1rem;
    }
    .calendar-btn:hover {
      background: var(--text, #111);
      color: white;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      .event-poster-inline img {
        max-height: none;
        width: 100%;
      }
      
      .event-detail-grid {
        grid-template-columns: 1fr !important;
        gap: 2rem !important;
        padding: 1.5rem !important;
      }
      .event-info-sidebar {
        position: static !important;
        padding: 1.5rem !important;
      }
      h1 { font-size: 1.75rem !important; }
    }
  </style>

  <!-- BREADCRUMB -->
  <nav style="padding: 2rem 0; border-bottom: 1px solid var(--border, #E5E5E5);">
    <a href="/events" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); text-decoration: none;">
      ← Back to Events
    </a>
  </nav>

  <!-- EVENT DETAIL -->
  <section>
    <div class="event-detail-grid">
      <!-- Left Column: Content + Poster -->
      <div>
        <!-- Category -->
        <p style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 0.5rem;">
          {event.category || 'EVENT'}
        </p>

        <!-- Title -->
        <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111); margin-bottom: 1rem; line-height: 1.2;">
          {event.title}
        </h1>

        <!-- Description -->
        {event.description && (
          <div style="margin-bottom: 2rem;">
            <p style="font-size: 1rem; color: var(--text-muted, #666); line-height: 1.8; white-space: pre-wrap;">
              {event.description}
            </p>
          </div>
        )}

        <!-- POSTER DI BAWAH JUDUL -->
        {event.poster && (
          <div class="event-poster-inline">
            <img src={urlFor(event.poster).width(1200).url()} alt={event.title} />
          </div>
        )}
      </div>

      <!-- Right Column: Sidebar Info -->
      <aside class="event-info-sidebar">
        
        <!-- Tanggal & Waktu -->
        <div class="info-item">
          <p class="info-label">📅 Tanggal & Waktu</p>
          <p class="info-value" style="font-weight: 600;">
            {formatDay(event.startDate)}, {formatDate(event.startDate)}
          </p>
          <p class="info-value" style="color: #666; margin-top: 0.25rem;">
            {formatTime(event.startDate)} WITA
          </p>
        </div>

        <!-- Lokasi -->
        {event.location && (
          <div class="info-item">
            <p class="info-label">📍 Lokasi</p>
            <p class="info-value">{event.location}</p>
          </div>
        )}

        <!-- Titik Kumpul -->
        {event.meetingPoint && (
          <div class="info-item">
            <p class="info-label">🚩 Titik Kumpul</p>
            <p class="info-value">{event.meetingPoint}</p>
          </div>
        )}

        <!-- Titik Finish -->
        {event.finishPoint && (
          <div class="info-item">
            <p class="info-label">🏁 Titik Finish</p>
            <p class="info-value">{event.finishPoint}</p>
          </div>
        )}

        <!-- BIAYA: DINAMIS - Hanya tampil jika ada nilai valid (bukan 0, bukan kosong) -->
        {displayPrice && (
          <div class="info-item">
            <p class="info-label">💰 Biaya</p>
            <p class="info-value" style="font-size: 1.25rem; font-weight: 700;">
              {displayPrice}
            </p>
          </div>
        )}

        <!-- Kuota Peserta (FIREBASE) -->
        {event.quota && (
          <div class="info-item">
            <p class="info-label"> Kuota Peserta</p>
            <p class="quota-display" id="firebase-quota" data-slug={event.slug.current} data-initial={currentCount}>
              {currentCount} / {quota} peserta
            </p>
          </div>
        )}

        <!-- Kontak PIC -->
        {event.contactPIC && (
          <div class="info-item">
            <p class="info-label"> Kontak PIC</p>
            <p class="info-value">{event.contactPIC}</p>
          </div>
        )}

        <!-- Action Buttons -->
        {event.status === 'open' && event.quota && (
          <button 
            class="attend-btn"
            id="attend-btn-detail"
            data-slug={event.slug.current}
            data-quota={quota}
          >
            🙋 Saya akan hadir
          </button>
        )}

        <a 
          href={calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="calendar-btn"
        >
          📅 Tambah ke Google Calendar
        </a>

        {event.registrationLink && event.status !== 'finished' && event.status !== 'cancelled' && (
          <a 
            href={event.registrationLink}
            target="_blank"
            rel="noopener noreferrer"
            style="display: block; width: 100%; text-align: center; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: white; background: var(--text, #111); text-decoration: none; padding: 1rem; margin-top: 1rem; transition: all 0.2s ease;"
            onmouseover="this.style.backgroundColor='var(--accent, #C84B8E)'"
            onmouseout="this.style.backgroundColor='var(--text, #111)'"
          >
            📝 Daftar Sekarang
          </a>
        )}
      </aside>
    </div>
  </section>

  <!-- FIREBASE SDK + LOGIKA TOMBOL HADIR -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      
      // 1. Load Firebase Compat SDKs
      const appScript = document.createElement('script');
      appScript.src = 'https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js';
      document.head.appendChild(appScript);

      const dbScript = document.createElement('script');
      dbScript.src = 'https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js';
      document.head.appendChild(dbScript);

      dbScript.onload = function() {
        console.log('✅ Firebase SDK Loaded');
        
        // 2. Konfigurasi Firebase
        const firebaseConfig = {
          apiKey: "AIzaSyBnwsQrgK-D_1GTEsl10WtIJdw180o-CtA",
          authDomain: "ajgr-events.firebaseapp.com",
          databaseURL: "https://ajgr-events-default-rtdb.asia-southeast1.firebasedatabase.app",
          projectId: "ajgr-events",
          storageBucket: "ajgr-events.appspot.com",
          messagingSenderId: "358289277112",
          appId: "1:358289277112:web:8a5e4a2961670fd144f44d"
        };

        // Inisialisasi
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();
        console.log('✅ Firebase Initialized');

        // 3. Real-time Listener untuk Kuota
        const quotaDisplay = document.getElementById('firebase-quota');
        if (quotaDisplay) {
          const slug = quotaDisplay.getAttribute('data-slug');
          const initialCount = parseInt(quotaDisplay.getAttribute('data-initial')) || 0;
          const quota = parseInt(quotaDisplay.textContent.split('/')[1]?.trim()) || 25;

          const eventRef = database.ref('events/' + slug + '/attendeeCount');
          
          // Listen real-time
          eventRef.on('value', (snapshot) => {
            const count = snapshot.val() !== null ? snapshot.val() : initialCount;
            quotaDisplay.textContent = count + ' / ' + quota + ' peserta';
            
            if (count >= quota) {
              quotaDisplay.style.color = '#EF4444';
              quotaDisplay.style.fontWeight = '700';
            } else if (count > initialCount) {
              quotaDisplay.style.color = '#22C55E';
            }
          });
        }

        // 4. Logika Tombol "Saya akan hadir"
        const attendBtn = document.getElementById('attend-btn-detail');
        if (attendBtn) {
          const slug = attendBtn.getAttribute('data-slug');
          const quota = parseInt(attendBtn.getAttribute('data-quota'));
          const storageKey = 'ajgr_attended_' + slug;

          // Cek apakah sudah pernah klik di device ini
          if (localStorage.getItem(storageKey)) {
            markAsAttended(attendBtn);
          }

          attendBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            if (localStorage.getItem(storageKey)) return;

            // Loading state
            attendBtn.disabled = true;
            attendBtn.classList.add('loading');
            const originalHTML = attendBtn.innerHTML;
            attendBtn.innerHTML = '⏳ Memproses...';

            try {
              const countRef = database.ref('events/' + slug + '/attendeeCount');
              
              // Ambil nilai saat ini
              const snapshot = await countRef.once('value');
              const currentCount = snapshot.val() || 0;

              // Cek kuota
              if (currentCount >= quota) {
                alert('Maaf, kuota sudah penuh!');
                attendBtn.disabled = false;
                attendBtn.innerHTML = originalHTML;
                attendBtn.classList.remove('loading');
                return;
              }

              // Increment counter
              await countRef.set(currentCount + 1);
              
              // Simpan ke localStorage
              localStorage.setItem(storageKey, 'true');
              
              // Update UI
              markAsAttended(attendBtn);

            } catch (error) {
              console.error('❌ Error:', error);
              alert('Terjadi kesalahan: ' + error.message);
              attendBtn.disabled = false;
              attendBtn.innerHTML = originalHTML;
              attendBtn.classList.remove('loading');
            }
          });

          // Fungsi helper
          function markAsAttended(btn) {
            btn.innerHTML = '✓ ANDA SUDAH TERDAFTAR';
            btn.disabled = true;
            btn.classList.remove('loading');
          }
        }
      };

      dbScript.onerror = function() {
        console.error('❌ Gagal memuat Firebase SDK!');
      };
    });
  </script>
</Layout>