---
import Layout from '../layouts/Layout.astro'
import client from '../lib/sanity'
import { urlFor, getSiteSettings } from '../lib/sanity'

const settings = await getSiteSettings()

// === Pengaturan Homepage Sections ===
const hpSections = settings?.homepageSections || {}
const journalCount = hpSections.journalCount || 4
const archiveCount = hpSections.archiveCount || 4
const rolodexCount = hpSections.rolodexCount || 4
const marketplaceCount = hpSections.marketplaceCount || 4
const eventsCount = hpSections.eventsCount || 4

const showJournal = hpSections.showJournal !== false
const showArchive = hpSections.showArchive !== false
const showRolodex = hpSections.showRolodex !== false
const showMarketplace = hpSections.showMarketplace !== false
const showEvents = hpSections.showEvents !== false
const showFitting = hpSections.showFitting !== false

const journalTitle = hpSections.journalTitle || 'Latest from Journal'
const archiveTitle = hpSections.archiveTitle || 'Latest from Archive'
const rolodexTitle = hpSections.rolodexTitle || 'Recommended Rolodex'
const marketplaceTitle = hpSections.marketplaceTitle || 'Featured Parts'
const marketplaceLabel = hpSections.marketplaceLabel || '06 — MARKETPLACE'
const eventsTitle = hpSections.eventsTitle || 'Upcoming Events'
const eventsLabel = hpSections.eventsLabel || '05 — CALENDAR'
const fittingTitle = hpSections.fittingTitle || 'Bike Fitting Calculator'
const fittingLabel = hpSections.fittingLabel || 'FITTING'

// 1. Ambil artikel terbaru
const recentPosts = await client.fetch(`*[_type == "post"] | order(publishedAt desc)[0...${journalCount}]{
  title, slug, category, publishedAt, mainImage, body
}`)

// 2. Ambil bike terbaru
const recentBikes = await client.fetch(`*[_type == "bike" && isFeatured == true] | order(_createdAt desc)[0...${archiveCount}]{
  title, year, country, type, mainImage, slug
}`)

// 3. Ambil seller terbaru
const recentSellers = await client.fetch(`*[_type == "seller" && isFeatured == true] | order(_createdAt desc)[0...${rolodexCount}]{
  name, category, address, whatsapp, logo
}`)

// 4. Ambil event terdekat (HANYA yang isFeatured == true)
const featuredEvents = await client.fetch(`*[_type == "event" && isFeatured == true] | order(startDate asc)[0...${eventsCount}]{
  title, slug, startDate, category, location, status, poster
}`)

// 5. Ambil part marketplace unggulan
const featuredMarketplace = await client.fetch(`*[_type == "marketplace" && isFeatured == true] | order(_createdAt desc)[0...${marketplaceCount}]{
  title, slug, category, brand, price, status, sellerLocation, images
}`)

// Helper: Format kategori
function formatCategory(cat: string) {
  if (!cat) return ''
  if (cat === 'full-bike') return 'Full Bike'
  return cat.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')
}
---

<Layout settings={settings}>
  <!-- CSS RESPONSIVE KHUSUS HOMEPAGE -->
  <style>
    /* ===== BIKE FITTING MOBILE FIX ===== */
    @media (max-width: 768px) {
      .fitting-container {
        padding: 1.5rem !important;
      }
      
      .fitting-grid-2 {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
      }
      
      .fitting-input {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
      }
      
      .fitting-button {
        padding: 0.9rem 1rem !important;
        font-size: 0.8rem !important;
      }
      
      .fitting-results-grid {
        grid-template-columns: 1fr !important;
      }
    }

    /* ===== COLLAB FORM MOBILE FIX ===== */
    @media (max-width: 768px) {
      .collab-grid-2 {
        grid-template-columns: 1fr !important;
      }
      .collab-grid-2 > div {
        padding: 0 !important;
        margin-bottom: 0 !important;
      }
      .event-grid-home {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <!-- HERO SECTION -->
  <section style="padding: 6rem 0 4rem; border-bottom: 1px solid var(--border, #E5E5E5);">
    <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 1rem; display: block;">
      {settings?.heroSection?.subtitle || '— KOMUNITAS SEPEDA GIANYAR'}
    </span>
    
    <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; margin: 1rem 0 2rem;">
      {settings?.heroSection?.titleLine1 || 'Bersepeda,'}<br>
      <span style="font-style: italic; font-weight: 400; color: var(--accent, #C84B8E);">{settings?.heroSection?.titleLine2 || 'bercerita,'}</span><br>
      {settings?.heroSection?.titleLine3 || 'bersama.'}
    </h1>
    
    <p style="font-size: 1.125rem; color: var(--text-muted, #666666); line-height: 1.6; max-width: 500px;">
      {settings?.heroSection?.description || 'AJGR.cc adalah ruang digital untuk komunitas sepeda vintage dan klasik di Gianyar, Bali.'}
    </p>
  </section>

  <!-- LATEST JOURNAL SECTION -->
  {showJournal && (
    <section style="padding: 4rem 0;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid var(--border, #E5E5E5); padding-bottom: 1rem;">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 600;">{journalTitle}</h2>
        <a href="/journal" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border-bottom: 1px solid var(--text, #111);">View All</a>
      </div>

      {recentPosts.length > 0 ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
          {recentPosts.map((post: any) => (
            <a href={`/journal/${post.slug.current}`} style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--border, #E5E5E5); padding: 1.5rem; transition: background-color 0.3s ease;"
              onmouseover="this.style.backgroundColor='#F8F8F8'" 
              onmouseout="this.style.backgroundColor='transparent'">
              {post.mainImage ? (
                <div style="aspect-ratio: 16/10; background: #F5F5F5; margin-bottom: 1rem; overflow: hidden;">
                  <img src={urlFor(post.mainImage).width(600).url()} alt={post.title} style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
              ) : (
                <div style="aspect-ratio: 16/10; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%); margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
                  <span style="font-size: 3rem; color: white;">📖</span>
                </div>
              )}
              <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem; font-weight: 600;">
                {post.category}
              </span>
              <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; line-height: 1.3;">{post.title}</h3>
              <p style="font-size: 0.85rem; color: #666; line-height: 1.6; margin-bottom: 0.75rem;">
                {post.body?.[0]?.children?.map((c: any) => c.text).join('').substring(0, 60)}...
              </p>
              <p style="font-size: 0.75rem; color: #999;">
                {new Date(post.publishedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: 3rem; border: 1px solid var(--border, #E5E5E5);">
          <p style="color: #666; font-size: 0.9rem;">Belum ada artikel. Tambahkan di dashboard Sanity.</p>
        </div>
      )}
    </section>
  )}

  <!-- ARCHIVE PREVIEW -->
  {showArchive && (
    <section style="padding: 4rem 0; border-top: 1px solid var(--border, #E5E5E5);">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid var(--border, #E5E5E5); padding-bottom: 1rem;">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 600;">{archiveTitle}</h2>
        <a href="/archive" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border-bottom: 1px solid var(--text, #111);">View All</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
        {recentBikes.map((bike: any) => (
          <a href={`/archive/${bike.slug.current}`} 
            style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--border, #E5E5E5); padding: 1.5rem; transition: all 0.3s ease; cursor: pointer;"
            onmouseover="this.style.backgroundColor='#F8F8F8'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)'" 
            onmouseout="this.style.backgroundColor='transparent'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            
            <div style="aspect-ratio: 16/10; background: #F5F5F5; margin-bottom: 1rem; overflow: hidden; border-radius: 4px;">
              {bike.mainImage ? (
                <img src={urlFor(bike.mainImage).width(600).url()} alt={bike.title} style="width: 100%; height: 100%; object-fit: cover;" />
              ) : (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem;">🚲</div>
              )}
            </div>
            
            <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #666; display: block; margin-bottom: 0.5rem;">
              {bike.year} — {bike.country}
            </span>
            
            <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; line-height: 1.3;">{bike.title}</h3>
            <p style="font-size: 0.85rem; color: #666;">{bike.type}</p>
            
            <div style="margin-top: 1rem; display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; color: var(--text, #111);">Detail</span>
              <span style="font-size: 1rem;">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- RECOMMENDED ROLODEX SECTION -->
  {showRolodex && (
    <section style="padding: 4rem 0; border-top: 1px solid var(--border, #E5E5E5);">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; border-bottom: 1px solid var(--border, #E5E5E5); padding-bottom: 1rem;">
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 600;">{rolodexTitle}</h2>
        <a href="/rolodex" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border-bottom: 1px solid var(--text, #111);">View All</a>
      </div>

      {recentSellers.length > 0 ? (
       <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
          {recentSellers.map((seller: any) => (
            <article style="border: 1px solid var(--border, #E5E5E5); padding: 1.5rem; transition: background-color 0.3s ease;"
                    onmouseover="this.style.backgroundColor='#F8F8F8'" 
                    onmouseout="this.style.backgroundColor='transparent'">
              {seller.logo && (
                <div style="width: 60px; height: 60px; background: #F5F5F5; border-radius: 4px; overflow: hidden; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
                  <img src={urlFor(seller.logo).width(120).url()} alt={seller.name} style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
              )}
              <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem; font-weight: 600;">
                {seller.category || 'COMMUNITY'}
              </span>
              <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">{seller.name}</h3>
              {seller.address && (
                <p style="font-size: 0.85rem; color: #666; line-height: 1.6; margin-bottom: 1rem;">
                  {seller.address}
                </p>
              )}
              {seller.whatsapp && (
                <a href={`https://wa.me/${seller.whatsapp}`} target="_blank" rel="noopener noreferrer" 
                  style="display: inline-block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border: 1px solid var(--text, #111); padding: 0.5rem 1rem; transition: all 0.2s ease;"
                  onmouseover="this.style.backgroundColor='var(--text, #111)'; this.style.color='#FAFAFA'"
                  onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--text, #111)'">
                  Contact →
                </a>
              )}
            </article>
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: 3rem; border: 1px solid var(--border, #E5E5E5);">
          <p style="color: #666; font-size: 0.9rem;">Belum ada rekomendasi. Tambahkan di dashboard Sanity.</p>
        </div>
      )}
    </section>
  )}

  <!-- FEATURED MARKETPLACE SECTION -->
  {showMarketplace && (
    <section style="padding: 6rem 0; border-top: 1px solid var(--border, #E5E5E5);">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; border-bottom: 1px solid var(--border, #E5E5E5); padding-bottom: 1rem;">
        <div>
          <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem;">
            {marketplaceLabel}
          </span>
          <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111);">
            {marketplaceTitle}
          </h2>
        </div>
        <a href="/marketplace" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text, #111); text-decoration: none; border-bottom: 1px solid var(--text, #111);">
          View All →
        </a>
      </div>

      {featuredMarketplace.length > 0 ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
          {featuredMarketplace.map((item: any) => {
            const statusColors: any = { available: '#22C55E', reserved: '#EAB308', sold: '#EF4444' }
            const statusLabels: any = { available: 'Tersedia', reserved: 'Reserved', sold: 'Terjual' }
            return (
              <a href={`/marketplace/${item.slug.current}`} style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--border, #E5E5E5); transition: background-color 0.3s ease; position: relative;" onmouseover="this.style.backgroundColor='#F8F8F8'" onmouseout="this.style.backgroundColor='transparent'">
                <div style="position: absolute; top: 1rem; right: 1rem; background: {statusColors[item.status] || '#22C55E'}; color: white; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; padding: 0.2rem 0.6rem; border-radius: 2px; z-index: 10;">
                  {statusLabels[item.status] || 'Tersedia'}
                </div>
                <div style="aspect-ratio: 16/10; background: #F5F5F5; overflow: hidden;">
                  {item.images?.[0] ? (
                    <img src={urlFor(item.images[0]).width(600).url()} alt={item.title} style="width: 100%; height: 100%; object-fit: cover;" />
                  ) : (
                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%);">
                      <span style="font-size: 3rem; color: white;">🔧</span>
                    </div>
                  )}
                </div>
                <div style="padding: 1.5rem;">
                  <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666);">
                    {formatCategory(item.category)} {item.brand ? `· ${item.brand}` : ''}
                  </span>
                  <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; margin: 0.5rem 0; line-height: 1.3;">{item.title}</h3>
                  <p style="font-size: 1.25rem; font-weight: 700; color: var(--text, #111); margin-bottom: 0.5rem;">Rp {item.price?.toLocaleString('id-ID')}</p>
                  <p style="font-size: 0.85rem; color: var(--text-muted, #666);">📍 {item.sellerLocation || '-'}</p>
                </div>
              </a>
            )
          })}
        </div>
      ) : (
        <div style="text-align: center; padding: 3rem; border: 1px solid var(--border, #E5E5E5);">
          <p style="color: #666; font-size: 0.9rem;">Belum ada part unggulan. Tambahkan di dashboard Sanity.</p>
        </div>
      )}
    </section>
  )}

  <!-- BIKE FITTING CALCULATOR SECTION -->
  {showFitting && (
    <section style="padding: 6rem 0; border-top: 1px solid var(--border, #E5E5E5);">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem; border-bottom: 1px solid var(--border, #E5E5E5); padding-bottom: 1rem;">
        <div>
          <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem;">
            {fittingLabel}
          </span>
          <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111);">
            {fittingTitle}
          </h2>
        </div>
      </div>

      <div style="max-width: 800px; margin: 0 auto; padding: 0 1rem;">
        <div id="fitting-form" class="fitting-container" style="border: 1px solid var(--border, #E5E5E5); padding: 2.5rem; border-radius: 4px; background: #FAFAFA;">
          <div style="display: grid; gap: 1.5rem;">
            <div>
              <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Jenis Sepeda</label>
              <select id="bikeType" class="fitting-input" style="width: 100%; max-width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border, #E5E5E5); background: white; font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; box-sizing: border-box;">
                <option value="road">Road Bike (Sepeda Jalan)</option>
                <option value="mtb">MTB / Gravel / City Bike</option>
              </select>
            </div>

            <div class="fitting-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
              <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Tinggi Badan (cm)</label>
                <input type="number" id="height" class="fitting-input" placeholder="Contoh: 170" style="width: 100%; max-width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border, #E5E5E5); background: white; font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; box-sizing: border-box;" />
              </div>
              <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Panjang Inseam (cm) *</label>
                <input type="number" id="inseam" class="fitting-input" placeholder="Contoh: 80" style="width: 100%; max-width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--border, #E5E5E5); background: white; font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; box-sizing: border-box;" />
                <p style="font-size: 0.7rem; color: #999; margin-top: 0.25rem;">* Jarak dari selangkangan ke lantai</p>
              </div>
            </div>

            <button onclick="calculateFitting()" class="fitting-button" style="width: 100%; padding: 1rem; background: var(--text, #111); color: white; font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; border: none; cursor: pointer; transition: background 0.2s; box-sizing: border-box;" onmouseover="this.style.backgroundColor='var(--accent, #C84B8E)'" onmouseout="this.style.backgroundColor='var(--text, #111)'">
              Hitung Rekomendasi Fitting →
            </button>
          </div>
        </div>

        <div id="fitting-result" style="display: none; margin-top: 2rem;">
          <div style="border: 1px solid var(--accent, #C84B8E); padding: 2.5rem; border-radius: 4px; background: white; position: relative;">
            <button onclick="resetForm()" style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 0.75rem; color: var(--text-muted, #666); cursor: pointer; text-decoration: underline;">Hitung Ulang</button>
            
            <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--accent, #C84B8E);">Hasil Rekomendasi Anda</h3>
            <p id="res-summary" style="font-size: 0.9rem; color: var(--text-muted, #666); margin-bottom: 2rem;"></p>
            
            <div style="background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%); padding: 2rem; border-radius: 4px; margin-bottom: 2rem; color: white;">
              <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.5rem; opacity: 0.9;">Rekomendasi Ukuran Frame</p>
              <p id="res-frame-size" style="font-family: 'Space Grotesk', sans-serif; font-size: 2.5rem; font-weight: 700; margin-bottom: 0.25rem;">-</p>
              <p id="res-frame-note" style="font-size: 0.85rem; opacity: 0.95;"></p>
            </div>
            
            <div class="fitting-results-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
              <div style="padding: 1.5rem; background: #FAFAFA; border: 1px solid var(--border, #E5E5E5); border-radius: 4px;">
                <p style="font-size: 0.7rem; text-transform: uppercase; color: #999; margin-bottom: 0.5rem; letter-spacing: 0.05em;">Tinggi Saddle (dari BB)</p>
                <p id="res-saddle" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.75rem; font-weight: 700; color: var(--text, #111);">- cm</p>
              </div>
              <div style="padding: 1.5rem; background: #FAFAFA; border: 1px solid var(--border, #E5E5E5); border-radius: 4px;">
                <p style="font-size: 0.7rem; text-transform: uppercase; color: #999; margin-bottom: 0.5rem; letter-spacing: 0.05em;">Posisi Saddle</p>
                <p id="res-setback" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text, #111);">Netral</p>
              </div>
