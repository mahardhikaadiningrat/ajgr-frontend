  <!-- FORM KERJA SAMA SECTION (RESPONSIVE) -->
  <section style="padding: 6rem 0; border-top: 1px solid var(--border, #E5E5E5); background: #FAFAFA;">
    <div style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem;">
          PARTNERSHIP & COLLABORATION
        </span>
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111);">
          Form Kerja Sama dengan AJGR.cc
        </h2>
        <p style="margin-top: 1rem; font-size: 1rem; color: var(--text-muted, #666); line-height: 1.6;">
          Punya ide kolaborasi, ingin menjual sepeda vintage, atau request artikel? Isi form di bawah ini dan pesan Anda akan langsung terkirim ke WhatsApp tim kami.
        </p>
      </div>

      <form id="collabForm" data-whatsapp="6282147883637" style="background: white; padding: 2.5rem; border: 1px solid var(--border, #E5E5E5); border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        
        <div class="collab-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Nama Lengkap *</label>
            <input type="text" id="collabName" required style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border, #E5E5E5); border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 0.9rem; box-sizing: border-box;" />
          </div>
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Alamat Email *</label>
            <input type="email" id="collabEmail" required style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border, #E5E5E5); border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 0.9rem; box-sizing: border-box;" />
          </div>
        </div>

        <div class="collab-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">No. WhatsApp Anda</label>
            <input type="text" id="collabPhone" placeholder="Contoh: 08123456789" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border, #E5E5E5); border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 0.9rem; box-sizing: border-box;" />
          </div>
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Jenis Kerja Sama *</label>
            <select id="collabType" required style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border, #E5E5E5); border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 0.9rem; background: white; box-sizing: border-box;">
              <option value="" disabled selected>Pilih jenis kerja sama...</option>
              <option value="Kolaborasi Event">Kolaborasi Event</option>
              <option value="Jual Sepeda atau Part Sepeda">Jual Sepeda atau Part Sepeda</option>
              <option value="Request Penambahan Katalog Sepeda Vintage">Request Penambahan Katalog Sepeda Vintage</option>
              <option value="Request Penulisan Artikel Backlink">Request Penulisan Artikel Backlink</option>
            </select>
          </div>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.5rem;">Pesan / Detail Permintaan *</label>
          <textarea id="collabMessage" rows="5" required placeholder="Jelaskan detail permintaan Anda di sini..." style="width: 100%; padding: 0.85rem 1rem; border: 1px solid var(--border, #E5E5E5); border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 0.9rem; resize: vertical; box-sizing: border-box;"></textarea>
        </div>

        <div>
          <button type="submit" id="submitBtn" style="width: 100%; padding: 1rem; background: #25D366; color: white; font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; border: none; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <span style="font-size: 1.2rem;">💬</span>
            <span>Kirim via WhatsApp</span>
          </button>
          <p style="text-align: center; margin-top: 0.75rem; font-size: 0.75rem; color: #999;">
            Dengan mengklik tombol ini, Anda akan diarahkan ke WhatsApp dengan pesan yang sudah terformat otomatis.
          </p>
        </div>
      </form>
    </div>
  </section>

  <!-- SCRIPT HANDLE FORM → WHATSAPP -->
  <script is:inline>
    const form = document.getElementById('collabForm');
    const submitBtn = document.getElementById('submitBtn');
    const recipientWhatsApp = form.getAttribute('data-whatsapp');

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const name = document.getElementById('collabName').value.trim();
      const email = document.getElementById('collabEmail').value.trim();
      const phone = document.getElementById('collabPhone').value.trim();
      const collabType = document.getElementById('collabType').value;
      const message = document.getElementById('collabMessage').value.trim();

      if (!name || !email || !collabType || !message) {
        alert('Mohon lengkapi semua field yang wajib diisi (*).');
        return;
      }

      const waMessage = 
`Halo AJGR.cc! 👋

Saya ingin mengajukan kerja sama melalui website.

 *DETAIL PERMINTAAN:*

 *Nama:* ${name}
📧 *Email:* ${email}
📱 *No. WhatsApp:* ${phone || '-'}

🎯 *Jenis Kerja Sama:*
${collabType}

💬 *Pesan:*
${message}

---
_Pesan ini dikirim otomatis melalui form kerja sama di AJGR.cc_`;

      const encodedMessage = encodeURIComponent(waMessage);
      submitBtn.innerHTML = '<span></span><span>Membuka WhatsApp...</span>';
      submitBtn.disabled = true;

      setTimeout(() => {
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        const waUrl = isMobile 
          ? `https://wa.me/${recipientWhatsApp}?text=${encodedMessage}`
          : `https://web.whatsapp.com/send?phone=${recipientWhatsApp}&text=${encodedMessage}`;

        window.open(waUrl, '_blank');
        form.reset();
        submitBtn.innerHTML = '<span style="font-size: 1.2rem;">✅</span><span>Pesan Terkirim!</span>';
        submitBtn.style.backgroundColor = '#22C55E';

        setTimeout(() => {
          submitBtn.innerHTML = '<span style="font-size: 1.2rem;">💬</span><span>Kirim via WhatsApp</span>';
          submitBtn.style.backgroundColor = '#25D366';
          submitBtn.disabled = false;
        }, 3000);
      }, 500);
    });
  </script>

  <!-- SCRIPT FITTING -->
  <script is:inline>
    function calculateFitting() {
      const bikeTypeElement = document.getElementById('bikeType');
      const heightElement = document.getElementById('height');
      const inseamElement = document.getElementById('inseam');
      
      if (!bikeTypeElement || !heightElement || !inseamElement) {
        alert('Form tidak ditemukan. Silakan refresh halaman.');
        return;
      }

      const bikeType = bikeTypeElement.value;
      const height = parseFloat(heightElement.value);
      const inseam = parseFloat(inseamElement.value);

      if (!height || !inseam) {
        alert('Mohon isi Tinggi Badan dan Panjang Inseam dengan benar.');
        return;
      }

      let saddleHeight = '', setback = 'Netral (tengah rel)', drop = '', frameSize = '', frameNote = '', advice = '', summary = '';

      if (bikeType === 'road') {
        saddleHeight = (inseam * 0.883).toFixed(1);
        drop = (height * 0.06).toFixed(1);
        setback = 'Sedikit ke belakang dari BB';
        advice = 'Untuk road bike, posisi saddle yang tepat sangat krusial untuk efisiensi kayuhan. Pastikan lutut tidak terlalu lurus (lock) di bagian bawah kayuhan.';
        summary = 'Road Bike · Tinggi ' + height + 'cm · Inseam ' + inseam + 'cm';

        if (height < 160) { frameSize = '48 - 50 cm'; frameNote = 'Ukuran XS - S · Cocok untuk tinggi badan di bawah 160cm'; }
        else if (height < 170) { frameSize = '51 - 53 cm'; frameNote = 'Ukuran S - M · Cocok untuk tinggi badan 160-170cm'; }
        else if (height < 180) { frameSize = '54 - 56 cm'; frameNote = 'Ukuran M - L · Cocok untuk tinggi badan 170-180cm'; }
        else if (height < 190) { frameSize = '57 - 59 cm'; frameNote = 'Ukuran L - XL · Cocok untuk tinggi badan 180-190cm'; }
        else { frameSize = '60+ cm'; frameNote = 'Ukuran XXL · Cocok untuk tinggi badan di atas 190cm'; }
      } else {
        saddleHeight = (inseam * 0.885).toFixed(1);
        drop = (height * 0.03).toFixed(1);
        setback = 'Netral atau sedikit ke depan';
        advice = 'Untuk MTB/Gravel, saddle biasanya diatur sedikit lebih rendah dari road bike untuk memberikan ruang gerak tubuh saat menghadapi medan teknis dan turunan.';
        summary = 'MTB / Gravel · Tinggi ' + height + 'cm · Inseam ' + inseam + 'cm';

        if (height < 160) { frameSize = '15"'; frameNote = 'Ukuran XS · Cocok untuk tinggi badan di bawah 160cm'; }
        else if (height < 170) { frameSize = '17 - 18"'; frameNote = 'Ukuran S - M · Cocok untuk tinggi badan 160-170cm'; }
        else if (height < 180) { frameSize = '19 - 20"'; frameNote = 'Ukuran M - L · Cocok untuk tinggi badan 170-180cm'; }
        else if (height < 190) { frameSize = '21 - 22"'; frameNote = 'Ukuran L - XL · Cocok untuk tinggi badan 180-190cm'; }
        else { frameSize = '23"'; frameNote = 'Ukuran XXL · Cocok untuk tinggi badan di atas 190cm'; }
      }

      document.getElementById('res-saddle').innerText = saddleHeight + ' cm';
      document.getElementById('res-setback').innerText = setback;
      document.getElementById('res-drop').innerText = drop + ' cm';
      document.getElementById('res-advice').innerText = advice;
      document.getElementById('res-frame-size').innerText = frameSize;
      document.getElementById('res-frame-note').innerText = frameNote;
      document.getElementById('res-summary').innerText = summary;

      document.getElementById('fitting-form').style.display = 'none';
      const resultEl = document.getElementById('fitting-result');
      resultEl.style.display = 'block';
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetForm() {
      document.getElementById('fitting-result').style.display = 'none';
      document.getElementById('fitting-form').style.display = 'block';
      document.getElementById('height').value = '';
      document.getElementById('inseam').value = '';
    }
  </script>
</Layout>