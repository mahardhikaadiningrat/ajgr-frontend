---
export const prerender = false;

import Layout from '../../layouts/Layout.astro'
import client from '../../lib/sanity'
import { urlFor, getSiteSettings } from '../../lib/sanity'

const { slug } = Astro.params

// Ambil data item + relatedBike (jika ada)
const item = await client.fetch(`*[_type == "marketplace" && slug.current == $slug][0]{
  title, slug, category, brand, price, condition, year, description, status,
  sellerName, sellerPhone, sellerLocation,
  images,
  relatedBike->{title, slug, year, country, type, mainImage}
}`, { slug })

if (!item) {
  return Astro.redirect('/marketplace')
}

const settings = await getSiteSettings()

// Helper: Format Rupiah
function formatRupiah(angka: number) {
  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka)
}

// Helper: Warna status
function getStatusColor(status: string) {
  if (status === 'available') return '#22C55E'
  if (status === 'reserved') return '#EAB308'
  return '#EF4444'
}

function formatStatus(status: string) {
  const map: any = { available: 'Tersedia', reserved: 'Reserved', sold: 'Terjual' }
  return map[status] || status
}

function formatCountry(c: string) {
  const map: any = { japan: 'Jepang', europe: 'Eropa', usa: 'Amerika', other: 'Lainnya' }
  return map[c] || c
}

function formatType(t: string) {
  const map: any = { road: 'Road Bike', track: 'Track/Fixie', mtb: 'MTB/ATB', city: 'City/Commuter', touring: 'Touring', bmx: 'BMX' }
  return map[t] || t
}

// Helper: Format kategori
function formatCategory(cat: string) {
  if (!cat) return ''
  if (cat === 'full-bike') return 'Full Bike'
  return cat.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')
}

// Logic Tombol WhatsApp
const isAvailable = item.status === 'available'
const cleanPhone = item.sellerPhone?.replace(/[^0-9]/g, '') || ''
const waMessage = `Halo ${item.sellerName || 'Penjual'}, saya tertarik dengan part ini di AJGR.cc Marketplace:%0A%0A📦 *${item.title}*%0A💰 ${formatRupiah(item.price)}%0A🔗 ${Astro.request.url}%0A%0AApakah masih tersedia? Terima kasih!`
const waLink = `https://wa.me/${cleanPhone}?text=${waMessage}`
---

<Layout settings={settings}>
  <!-- CSS RESPONSIVE KHUSUS DETAIL MARKETPLACE -->
  <style>
    html, body {
      overflow-x: hidden !important;
      max-width: 100vw !important;
    }
    * {
      box-sizing: border-box;
    }
    img {
      max-width: 100% !important;
      height: auto;
      display: block;
    }

    /* Desktop Layouts */
    .detail-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
      align-items: start;
      padding: 4rem 0 6rem;
    }

    .specs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .related-grid {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 2rem;
      padding: 2rem;
    }

    /* ===== CTA BUTTONS CONTAINER ===== */
    .cta-container {
      display: flex;
      gap: 1rem;
      width: 100%;
    }

    .cta-btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      padding: 1.25rem;
      transition: all 0.2s ease;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      text-align: center;
    }

    .wa-btn {
      background: #25D366;
      color: white;
    }
    .wa-btn:hover {
      background: #128C7E;
      transform: translateY(-2px);
    }

    .share-btn {
      background: var(--text, #111);
      color: white;
    }
    .share-btn:hover {
      background: #333;
      transform: translateY(-2px);
    }

    .share-btn.copied {
      background: #22C55E !important;
      transform: none !important;
    }

    .disabled-btn {
      background: #F0F0F0;
      color: #999;
      cursor: not-allowed;
      transform: none !important;
    }

    /* Mobile Responsive Fixes */
    @media (max-width: 768px) {
      .detail-grid {
        grid-template-columns: 1fr !important;
        gap: 2rem !important;
        padding: 2rem 1rem !important;
      }

      .specs-grid {
        grid-template-columns: 1fr !important;
      }

      .related-grid {
        grid-template-columns: 1fr !important;
        gap: 1.5rem !important;
        padding: 1.5rem !important;
      }

      /* CTA Buttons jadi vertikal di mobile */
      .cta-container {
        flex-direction: column !important;
      }

      h1 {
        font-size: 1.75rem !important;
        word-break: break-word;
      }

      .price-text {
        font-size: 1.75rem !important;
      }

      .thumbnail-grid {
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 0.5rem !important;
      }
    }
  </style>

  <!-- BREADCRUMB -->
  <nav style="padding: 2rem 1rem; border-bottom: 1px solid var(--border, #E5E5E5); max-width: 100vw; overflow: hidden;">
    <a href="/marketplace" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); text-decoration: none;">
      ← Back to Marketplace
    </a>
  </nav>

  <!-- MAIN CONTENT -->
  <section class="detail-grid">
    
    <!-- LEFT: IMAGES -->
    <div>
      <!-- Main Image -->
      <div style="aspect-ratio: 4/3; background: #F0F0F0; overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border, #E5E5E5);">
        {item.images?.[0] ? (
          <img src={urlFor(item.images[0]).width(1000).url()} alt={item.title} style="width: 100%; height: 100%; object-fit: cover;" />
        ) : (
          <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%);">
            <span style="font-size: 5rem; color: white;">🔧</span>
          </div>
        )}
      </div>
      
      <!-- Gallery Thumbnails -->
      {item.images && item.images.length > 1 && (
        <div class="thumbnail-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
          {item.images.slice(1).map((img: any) => (
            <div style="aspect-ratio: 1/1; background: #F0F0F0; overflow: hidden; border: 1px solid var(--border, #E5E5E5);">
              <img src={urlFor(img).width(200).url()} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- RIGHT: INFO & CTA -->
    <div>
      <!-- Status Badge -->
      <div style="display: inline-block; background: {getStatusColor(item.status)}; color: white; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; padding: 0.4rem 1rem; margin-bottom: 1.5rem; border-radius: 2px;">
        {formatStatus(item.status)}
      </div>

      <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem;">
        {formatCategory(item.category)} {item.brand ? `· ${item.brand}` : ''}
      </span>

      <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1rem; line-height: 1.1; word-break: break-word;">
        {item.title}
      </h1>

      <p class="price-text" style="font-size: 2.5rem; font-weight: 700; color: var(--text, #111); margin-bottom: 2rem;">
        {formatRupiah(item.price)}
      </p>

      <!-- Spesifikasi Singkat -->
      <div class="specs-grid" style="padding: 1.5rem; background: #FAFAFA; border: 1px solid var(--border, #E5E5E5); margin-bottom: 2rem;">
        {item.condition && (
          <div>
            <p style="font-size: 0.7rem; text-transform: uppercase; color: #999; margin-bottom: 0.25rem;">Kondisi</p>
            <p style="font-weight: 500; font-size: 0.95rem; word-break: break-word;">{item.condition}</p>
          </div>
        )}
        {item.year && (
          <div>
            <p style="font-size: 0.7rem; text-transform: uppercase; color: #999; margin-bottom: 0.25rem;">Tahun</p>
            <p style="font-weight: 500; font-size: 0.95rem;">{item.year}</p>
          </div>
        )}
        {item.sellerLocation && (
          <div style="grid-column: 1 / -1;">
            <p style="font-size: 0.7rem; text-transform: uppercase; color: #999; margin-bottom: 0.25rem;">Lokasi</p>
            <p style="font-weight: 500; font-size: 0.95rem; word-break: break-word;">📍 {item.sellerLocation}</p>
          </div>
        )}
      </div>

      <!-- Deskripsi -->
      {item.description && (
        <div style="margin-bottom: 2rem;">
          <h3 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.75rem;">Deskripsi</h3>
          <p style="font-size: 1rem; line-height: 1.7; color: var(--text, #111); white-space: pre-wrap; word-break: break-word;">{item.description}</p>
        </div>
      )}

      <!-- Info Penjual -->
      <div style="padding: 1.5rem; border: 1px solid var(--border, #E5E5E5); margin-bottom: 2rem;">
        <h3 style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted, #666); margin-bottom: 0.75rem;">Penjual</h3>
        <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem;">{item.sellerName || 'Anonim'}</p>
        <p style="font-size: 0.9rem; color: var(--text-muted, #666);">📱 {item.sellerPhone ? `+${item.sellerPhone}` : '-'}</p>
      </div>

      <!-- CTA BUTTONS (WhatsApp + Share) -->
      <div class="cta-container" style="margin-bottom: 1rem;">
        {isAvailable ? (
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="cta-btn wa-btn">
            💬 Hubungi Penjual
          </a>
        ) : (
          <div class="cta-btn disabled-btn">
            {item.status === 'sold' ? '🔴 Sudah Terjual' : '🟡 Di-Reserved'}
          </div>
        )}
        
        <button id="share-btn" class="cta-btn share-btn">
          🔗 Share Link
        </button>
      </div>
      
      <p style="text-align: center; font-size: 0.75rem; color: var(--text-muted, #666); margin-top: 1rem; line-height: 1.5;">
        Transaksi dilakukan langsung dengan penjual.<br />AJGR.cc tidak memproses pembayaran.
      </p>
    </div>
  </section>

  <!-- FITUR: REFERENSI KATALOG (RELATED BIKE) -->
  {item.relatedBike && (
    <section style="padding: 4rem 1rem; border-top: 1px solid var(--border, #E5E5E5); max-width: 100vw; overflow: hidden;">
      <div style="margin-bottom: 2rem; max-width: 1200px; margin-left: auto; margin-right: auto;">
        <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); display: block; margin-bottom: 0.5rem;">
           COCOK UNTUK
        </span>
        <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.75rem; font-weight: 600; letter-spacing: -0.02em; color: var(--text, #111);">
          Sepeda Terkait di Katalog
        </h2>
        <p style="font-size: 0.95rem; color: var(--text-muted, #666); margin-top: 0.5rem;">
          Part ini cocok atau kompatibel dengan sepeda berikut yang ada di katalog AJGR.cc
        </p>
      </div>

      <a href={`/archive/${item.relatedBike.slug.current}`} 
         class="related-card"
         style="display: grid; max-width: 1200px; margin: 0 auto; text-decoration: none; color: inherit; transition: all 0.3s ease; background: #FAFAFA; border: 1px solid var(--border, #E5E5E5); border-radius: 4px;"
         onmouseover="this.style.backgroundColor='#F0F0F0'; this.style.borderColor='var(--accent, #C84B8E)'"
         onmouseout="this.style.backgroundColor='#FAFAFA'; this.style.borderColor='var(--border, #E5E5E5)'">
        
        <div class="related-grid">
          <!-- Foto Sepeda -->
          <div style="aspect-ratio: 4/3; background: #F0F0F0; overflow: hidden; border-radius: 4px;">
            {item.relatedBike.mainImage ? (
              <img src={urlFor(item.relatedBike.mainImage).width(600).url()} alt={item.relatedBike.title} style="width: 100%; height: 100%; object-fit: cover;" />
            ) : (
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #C84B8E 0%, #E8C547 100%);">
                <span style="font-size: 3rem; color: white;">🚲</span>
              </div>
            )}
          </div>

          <!-- Info Sepeda -->
          <div style="display: flex; flex-direction: column; justify-content: center;">
            <span style="font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent, #C84B8E); margin-bottom: 0.5rem;">
              {item.relatedBike.year} · {formatCountry(item.relatedBike.country)} · {formatType(item.relatedBike.type)}
            </span>
            <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 1rem; color: var(--text, #111); word-break: break-word;">
              {item.relatedBike.title}
            </h3>
            <p style="font-size: 0.9rem; color: var(--text-muted, #666); margin-bottom: 1.5rem; line-height: 1.6;">
              Lihat spesifikasi lengkap, cerita, dan foto sepeda ini di katalog AJGR.cc
            </p>
            <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent, #C84B8E); display: inline-flex; align-items: center; gap: 0.5rem; width: fit-content;">
              Lihat di Katalog →
            </span>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- SCRIPT: COPY TO CLIPBOARD -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const shareBtn = document.getElementById('share-btn');
      
      if (shareBtn) {
        shareBtn.addEventListener('click', async function() {
          const urlToCopy = window.location.href;
          
          try {
            await navigator.clipboard.writeText(urlToCopy);
            
            // Simpan teks asli
            const originalText = this.innerHTML;
            
            // Ubah tampilan menjadi "Copied"
            this.innerHTML = '✅ Copied!';
            this.classList.add('copied');
            
            // Kembalikan ke tampilan semula setelah 2 detik
            setTimeout(() => {
              this.innerHTML = originalText;
              this.classList.remove('copied');
            }, 2000);
            
          } catch (err) {
            console.error('Gagal menyalin link:', err);
            // Fallback untuk browser lama
            const textArea = document.createElement('textarea');
            textArea.value = urlToCopy;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            
            this.innerHTML = '✅ Copied!';
            this.classList.add('copied');
            setTimeout(() => {
              this.innerHTML = '🔗 Share Link';
              this.classList.remove('copied');
            }, 2000);
          }
        });
      }
    });
  </script>
</Layout>